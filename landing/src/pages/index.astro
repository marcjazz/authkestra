---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import FlowAnimation from '../components/FlowAnimation.astro';
import WhyAuthkestra from '../components/WhyAuthkestra.astro';
import AuthMethods from '../components/AuthMethods.astro';
import Comparison from '../components/Comparison.astro';
import Quickstart from '../components/Quickstart.astro';
import Footer from '../components/Footer.astro';
---
<Layout
  title="Authkestra — one Rust engine, every auth method"
  description="Authkestra is a modular, framework-agnostic authentication orchestration engine for Rust. Compile-time safe, stateless OAuth, and framework/database agnostic."
>
  <Nav />
  <main>
    <Hero />
    <FlowAnimation />
    <WhyAuthkestra />
    <AuthMethods />
    <Comparison />
    <Quickstart />
  </main>
  <Footer />
</Layout>
