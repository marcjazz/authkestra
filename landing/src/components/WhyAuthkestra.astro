---
import Icon from './Icon.astro';

const cards = [
  {
    icon: 'shield',
    title: 'Compile-time safety',
    body: 'The typestate builder pattern turns a misconfigured engine into a compiler error, not a 2am runtime surprise.',
  },
  {
    icon: 'feather',
    title: 'Stateless OAuth',
    body: 'State and nonce live in encrypted cookies, never your database — so the engine scales horizontally without a shared session store.',
  },
  {
    icon: 'route',
    title: 'Flexible chaining',
    body: 'Token, session, basic, and custom strategies chain together in the engine, so a complex flow is composed, not bolted on.',
  },
  {
    icon: 'puzzle',
    title: 'Framework & database agnostic',
    body: 'The engine is pure Rust logic. Axum and Actix are isolated adapters, and storage is a trait you implement — no schema is ever assumed.',
  },
];
---
<section id="why" class="why" aria-labelledby="why-heading">
  <h2 id="why-heading">Why Authkestra</h2>
  <div class="grid">
    {cards.map((c) => (
      <div class="card">
        <Icon name={c.icon} size={32} class="card-icon" aria-hidden="true" />
        <h3>{c.title}</h3>
        <p>{c.body}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .why {
    max-width: var(--ak-layout-max);
    margin: 0 auto;
    padding: var(--ak-space-24) var(--ak-space-6);
  }

  h2 {
    font-size: var(--ak-text-3xl);
  }

  .grid {
    margin-top: var(--ak-space-10);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--ak-space-6);
  }

  .card {
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    padding: var(--ak-space-6);
  }

  /* The same set-not-competition case as AuthMethods; DESIGN.md §2, rule 1. */
  .card-icon {
    color: hsl(var(--primary-accent));
  }

  h3 {
    margin-top: var(--ak-space-4);
    font-size: var(--ak-text-base);
    font-weight: 600;
  }

  .card p {
    margin-top: var(--ak-space-2);
    font-size: var(--ak-text-sm);
    color: hsl(var(--muted-foreground));
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .why {
      padding: var(--ak-space-16) var(--ak-space-4);
    }
    .grid {
      grid-template-columns: 1fr;
      gap: var(--ak-space-4);
    }
  }
</style>
