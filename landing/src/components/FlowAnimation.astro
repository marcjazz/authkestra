---
import Icon from './Icon.astro';
import { highlightRust } from '../lib/rust-highlight';

const methods = [
  { id: 'passkey', label: 'Passkey', icon: 'fingerprint', cy: 46 },
  { id: 'totp', label: 'Authenticator code', icon: 'smartphone', cy: 116 },
  { id: 'oauth2', label: 'OAuth2', icon: 'key-round', cy: 186 },
  { id: 'device', label: 'Device flow', icon: 'tv-minimal', cy: 256 },
];

/*
  One snippet per method, and each is real: these are the calls the crate's
  own examples make, not an illustration of them. They differ in shape on
  purpose. Three register a strategy on the same builder, and the fourth does
  not — the device flow is its own object you drive directly, because there
  is no browser session to attach it to. Flattening that into a fourth
  builder line would have been tidier and untrue.
*/
const snippets: Record<string, string> = {
  passkey: `let engine = Authkestra::builder()
    .with_webauthn(Arc::new(webauthn), store.clone())
    .session_store(session_store)
    .build();`,

  totp: `let engine = Authkestra::builder()
    .provider(OAuth2Flow::new(github_provider))
    // Step-up only: it answers an MfaRequired challenge,
    // it is never a first factor on its own.
    .with_mfa_method(TotpAuthMethod::new(store))
    .build();`,

  oauth2: `let engine = Authkestra::builder()
    .provider(OAuth2Flow::new(github_provider))
    .session_store(session_store)
    .build();`,

  device: `let flow = DeviceFlow::new(client_id, device_auth_url, token_url);

let device = flow
    .initiate_device_authorization(&["user"])
    .await?;`,
};

const highlighted = Object.fromEntries(
  Object.entries(snippets).map(([id, code]) => [id, highlightRust(code)]),
);

// Engine → method fan, and method → verify fan, as smooth S-curves.
const EX = 150, EY = 150, MX = 420, VX = 650, VY = 150;
const curveOut = (my: number) =>
  `M${EX},${EY} C${EX + (MX - EX) * 0.55},${EY} ${EX + (MX - EX) * 0.45},${my} ${MX},${my}`;
const curveIn = (my: number) =>
  `M${MX},${my} C${MX + (VX - MX) * 0.55},${my} ${MX + (VX - MX) * 0.45},${VY} ${VX},${VY}`;
---
<section id="flow" class="flow" aria-labelledby="flow-heading">
  <div class="copy">
    <h2 id="flow-heading">One engine, dispatched at compile time</h2>
    <p>
      Every request lands on the same <code>Engine</code>. It hands off to whichever
      strategy you configured — a passkey, an authenticator code, an OAuth2 provider,
      a device flow — verifies the credential, mints a session or token, and returns
      the result. Below, the diagram cycles through all four so you can see one
        engine carry every route, and the panel beside it shows the code
        that registers whichever strategy is active. Three of them are the
        same builder; the device flow is its own object, because there is
        no browser session to hang it off.
    </p>
  </div>

  <div class="stage">
    <div class="visual">
      <svg
        class="diagram"
        viewBox="0 0 880 300"
        role="img"
        aria-hidden="true"
        data-active-method="passkey"
      >
        <!-- static rails: always visible, always neutral -->
        <g class="rails">
          <path class="rail" d={`M36,150 L150,150`} pathLength="1" />
          {methods.map((m) => <path class="rail" d={curveOut(m.cy)} pathLength="1" />)}
          {methods.map((m) => <path class="rail" d={curveIn(m.cy)} pathLength="1" />)}
          <path class="rail" d={`M650,150 L750,150`} pathLength="1" />
          <path class="rail" d={`M750,150 L840,150`} pathLength="1" />
        </g>

        <!-- animated pulses: rust, drawn in sequence, one lane at a time -->
        <g class="pulses">
          <path class="pulse p-req-engine" d={`M36,150 L150,150`} pathLength="1" />
          {methods.map((m) => (
            <path
              class="pulse p-engine-method"
              data-method={m.id}
              d={curveOut(m.cy)}
              pathLength="1"
            />
          ))}
          {methods.map((m) => (
            <path
              class="pulse p-method-verify"
              data-method={m.id}
              d={curveIn(m.cy)}
              pathLength="1"
            />
          ))}
          <path class="pulse p-verify-minted" d={`M650,150 L750,150`} pathLength="1" />
          <path class="pulse p-minted-returned" d={`M750,150 L840,150`} pathLength="1" />
        </g>

        <!-- nodes -->
        <g class="node-pop n-request" transform="translate(36,150)">
          <circle r="8" class="dot" />
        </g>

        <g class="node-pop n-engine" transform="translate(150,150)">
          <circle r="34" class="chip chip-engine" />
          <g transform="translate(-12,-12)" class="glyph glyph-neutral">
            <Icon name="square-function" size={24} />
          </g>
        </g>

        {methods.map((m) => (
          <g class="method" data-method={m.id} transform={`translate(420,${m.cy})`}>
            <g class="node-pop n-method" data-method={m.id}>
              <circle r="20" class="chip" />
              <g transform="translate(-11,-11)" class="glyph">
                <Icon name={m.icon} size={22} />
              </g>
            </g>
          </g>
        ))}

        <g class="node-pop n-verify" transform="translate(650,150)">
          <circle r="22" class="chip chip-neutral" />
          <g transform="translate(-11,-11)" class="glyph glyph-neutral">
            <Icon name="circle-check" size={22} />
          </g>
        </g>

        <g class="node-pop n-minted" transform="translate(750,150)">
          <circle r="20" class="chip chip-neutral" />
          <g transform="translate(-10,-10)" class="glyph glyph-neutral">
            <Icon name="ticket" size={20} />
          </g>
        </g>

        <g class="node-pop n-returned" transform="translate(840,150)">
          <circle r="18" class="chip chip-neutral" />
          <g transform="translate(-9,-9)" class="glyph glyph-neutral">
            <Icon name="circle-user" size={18} />
          </g>
        </g>
      </svg>

      <ul class="legend">
        {methods.map((m) => (
          <li data-method={m.id}>
            <Icon name={m.icon} size={16} aria-hidden="true" />
            <span>{m.label}</span>
          </li>
        ))}
      </ul>
      <p class="pipeline">Request → Engine → strategy → verified → minted → returned</p>
    </div>

    <div class="code-panel">
      <div class="code-chrome" aria-hidden="true">
        <span class="win"></span><span class="win"></span><span class="win"></span>
      </div>
      <div class="code-stack">
        {methods.map((m) => (
          <pre
            class:list={['code', { off: m.id !== 'oauth2' }]}
            data-snippet={m.id}
            aria-hidden={m.id !== 'oauth2' ? 'true' : undefined}
          ><code>{highlighted[m.id].map((line) => (
            <span class="code-line" set:html={line || '&nbsp;'} />
          ))}</code></pre>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const svg = document.querySelector<SVGSVGElement>('#flow .diagram');
  const snippetEls = document.querySelectorAll<HTMLElement>('#flow .code[data-snippet]');
  const legendItems = document.querySelectorAll<HTMLElement>('#flow .legend li');

  if (svg) {
    const methods = ['passkey', 'totp', 'oauth2', 'device'];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;

    const setActive = (method: string) => {
      svg.setAttribute('data-active-method', method);
      /*
        `visibility` via a class, not `hidden`. The four snippets are stacked
        in one grid cell so the panel is always as tall as the longest of
        them; removing the inactive ones from layout would make the panel
        jump height every time the diagram advances. `visibility: hidden`
        still takes them out of the accessibility tree, which is the part
        `hidden` was there for.
      */
      snippetEls.forEach((el) => {
        const off = el.dataset.snippet !== method;
        el.classList.toggle('off', off);
        if (off) el.setAttribute('aria-hidden', 'true');
        else el.removeAttribute('aria-hidden');
      });
      legendItems.forEach((l) => l.classList.toggle('active', l.dataset.method === method));
    };

    const cycle = () => {
      svg.classList.remove('run');
      // force reflow so the next class add restarts transitions/animations
      void svg.getBoundingClientRect();
      setActive(methods[i]);
      svg.classList.add('run');
      i = (i + 1) % methods.length;
    };

    if (reduced) {
      setActive('oauth2');
    } else {
      cycle();
      setInterval(cycle, 4200);
    }
  }
</script>

<style>
  .flow {
    max-width: var(--ak-layout-max);
    margin: 0 auto;
    padding: 0 var(--ak-space-6) var(--ak-space-24);
  }

  .copy {
    max-width: 62ch;
    margin-bottom: var(--ak-space-10);
  }

  .copy h2 {
    font-size: var(--ak-text-3xl);
  }

  .copy p {
    margin-top: var(--ak-space-4);
    color: hsl(var(--muted-foreground));
    font-size: var(--ak-text-base);
  }

  .copy code {
    background: hsl(var(--ak-neutral-800));
    padding: 0.1em 0.4em;
    border-radius: var(--ak-radius-sm);
    font-size: 0.9em;
    color: hsl(var(--foreground));
  }

  .stage {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--ak-space-8);
    align-items: start;
  }

  /* Same fix as Quickstart's .inner: without min-width:0 these grid items
     inherit min-width:auto, and the code panel's unwrapped Rust lines blow
     the shared track out past the viewport at narrow widths. */
  .visual,
  .code-panel {
    min-width: 0;
  }

  .visual {
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--ak-radius-xl);
    padding: var(--ak-space-6);
  }

  .diagram {
    width: 100%;
    height: auto;
  }

  /* rails: the four routes always visible, always neutral */
  .rail {
    fill: none;
    stroke: hsl(var(--border));
    stroke-width: 2;
  }

  /* pulses: rust, hidden until their segment's turn in the sequence */
  .pulse {
    fill: none;
    stroke: hsl(var(--ring));
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
    transition-property: opacity, stroke-dashoffset;
    transition-duration: 240ms, 460ms;
    transition-timing-function: var(--ak-ease-out), var(--ak-ease-out);
  }

  .diagram.run .p-req-engine { opacity: 1; stroke-dashoffset: 0; transition-delay: 0ms, 0ms; }
  .diagram.run .p-verify-minted { opacity: 1; stroke-dashoffset: 0; transition-delay: 1480ms, 1480ms; }
  .diagram.run .p-minted-returned { opacity: 1; stroke-dashoffset: 0; transition-delay: 1860ms, 1860ms; }

  .diagram.run[data-active-method='passkey'] .p-engine-method[data-method='passkey'],
  .diagram.run[data-active-method='totp'] .p-engine-method[data-method='totp'],
  .diagram.run[data-active-method='oauth2'] .p-engine-method[data-method='oauth2'],
  .diagram.run[data-active-method='device'] .p-engine-method[data-method='device'] {
    opacity: 1;
    stroke-dashoffset: 0;
    transition-delay: 480ms, 480ms;
  }

  .diagram.run[data-active-method='passkey'] .p-method-verify[data-method='passkey'],
  .diagram.run[data-active-method='totp'] .p-method-verify[data-method='totp'],
  .diagram.run[data-active-method='oauth2'] .p-method-verify[data-method='oauth2'],
  .diagram.run[data-active-method='device'] .p-method-verify[data-method='device'] {
    opacity: 1;
    stroke-dashoffset: 0;
    transition-delay: 980ms, 980ms;
  }

  /* nodes */
  .node-pop { transform-box: fill-box; transform-origin: center; }

  @keyframes pop {
    0% { transform: scale(1); }
    45% { transform: scale(1.16); }
    100% { transform: scale(1); }
  }

  .diagram.run .n-request,
  .diagram.run .n-engine { animation: pop 380ms var(--ak-ease-out) 60ms; }
  .diagram.run .n-verify { animation: pop 380ms var(--ak-ease-out) 1040ms; }
  .diagram.run .n-minted { animation: pop 380ms var(--ak-ease-out) 1520ms; }
  .diagram.run .n-returned { animation: pop 380ms var(--ak-ease-out) 1900ms; }

  .diagram.run[data-active-method='passkey'] .n-method[data-method='passkey'],
  .diagram.run[data-active-method='totp'] .n-method[data-method='totp'],
  .diagram.run[data-active-method='oauth2'] .n-method[data-method='oauth2'],
  .diagram.run[data-active-method='device'] .n-method[data-method='device'] {
    animation: pop 380ms var(--ak-ease-out) 560ms;
  }

  .dot { fill: hsl(var(--muted-foreground)); }

  .chip {
    fill: hsl(var(--background));
    stroke: hsl(var(--border));
    stroke-width: 1.5;
    transition: fill 320ms var(--ak-ease-out), stroke 320ms var(--ak-ease-out);
  }

  .chip-engine { stroke-width: 1.75; }

  .glyph { color: hsl(var(--muted-foreground)); transition: color 320ms var(--ak-ease-out); }
  .glyph-neutral { color: hsl(var(--foreground)); }

  /* the one accent that moves: the active method's chip + icon */
  svg[data-active-method='passkey'] .method[data-method='passkey'] .chip,
  svg[data-active-method='totp'] .method[data-method='totp'] .chip,
  svg[data-active-method='oauth2'] .method[data-method='oauth2'] .chip,
  svg[data-active-method='device'] .method[data-method='device'] .chip {
    fill: hsl(var(--primary-subtle));
    stroke: hsl(var(--ring));
  }

  svg[data-active-method='passkey'] .method[data-method='passkey'] .glyph,
  svg[data-active-method='totp'] .method[data-method='totp'] .glyph,
  svg[data-active-method='oauth2'] .method[data-method='oauth2'] .glyph,
  svg[data-active-method='device'] .method[data-method='device'] .glyph {
    color: hsl(var(--ring));
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ak-space-2) var(--ak-space-6);
    margin-top: var(--ak-space-6);
    padding-top: var(--ak-space-5);
    border-top: 1px solid hsl(var(--border));
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: var(--ak-space-2);
    font-size: var(--ak-text-sm);
    color: hsl(var(--muted-foreground));
    transition: color 320ms var(--ak-ease-out);
  }

  .legend li.active {
    color: hsl(var(--primary-accent));
  }

  .pipeline {
    margin-top: var(--ak-space-4);
    font-size: var(--ak-text-xs);
    color: hsl(var(--muted-foreground));
    font-family: var(--ak-font-mono);
  }

  .code-panel {
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--ak-radius-xl);
    overflow: hidden;
    align-self: stretch;
  }

  .code-chrome {
    display: flex;
    gap: var(--ak-space-2);
    padding: var(--ak-space-3) var(--ak-space-4);
    border-bottom: 1px solid hsl(var(--border));
  }

  .win {
    width: 9px;
    height: 9px;
    border-radius: var(--ak-radius-full);
    background: hsl(var(--border));
  }

  .code {
    margin: 0;
    padding: var(--ak-space-5);
    font-family: var(--ak-font-mono);
    font-size: var(--ak-text-sm);
    line-height: var(--ak-leading-relaxed);
    overflow-x: auto;
  }

  /* All four snippets occupy the same cell, so the panel never resizes. */
  .code-stack {
    display: grid;
  }

  .code-stack > .code {
    grid-area: 1 / 1;
  }

  .code.off {
    visibility: hidden;
  }

  .code-line {
    display: block;
    color: hsl(var(--code-plain));
    white-space: pre;
  }

  /*
    Three hues and three levels of brightness, from the design tokens rather
    than a highlighter's own theme — see DESIGN.md §7. The brightest thing in
    a line is the method being called, because that is the part that changes
    as the diagram moves from one strategy to the next.
  */
  .code-line :global(.t-keyword) { color: hsl(var(--code-keyword)); }
  .code-line :global(.t-type) { color: hsl(var(--code-type)); }
  .code-line :global(.t-literal) { color: hsl(var(--code-literal)); }
  .code-line :global(.t-macro) { color: hsl(var(--code-keyword)); }
  .code-line :global(.t-comment) { color: hsl(var(--code-comment)); font-style: italic; }
  .code-line :global(.t-fn) { color: hsl(var(--code-fn)); }



  @media (prefers-reduced-motion: reduce) {
    .pulse {
      opacity: 1 !important;
      stroke-dashoffset: 0 !important;
      transition: none !important;
    }
    .node-pop { animation: none !important; }
    .method .chip {
      fill: hsl(var(--primary-subtle)) !important;
      stroke: hsl(var(--ring)) !important;
    }
    .method .glyph { color: hsl(var(--ring)) !important; }
    .legend li { color: hsl(var(--primary-accent)) !important; }
  }

  @media (max-width: 900px) {
    .stage {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .flow {
      padding: 0 var(--ak-space-4) var(--ak-space-16);
    }
    .visual { padding: var(--ak-space-4); }
    .legend { gap: var(--ak-space-2) var(--ak-space-4); }
  }
</style>
