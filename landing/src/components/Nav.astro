---
import Icon from './Icon.astro';
---
<header class="nav">
  <nav class="bar" aria-label="Primary">
    <a class="wordmark" href="#top">
      <svg class="mark" width="22" height="22" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path d="M5.5 27.5 16 5l10.5 22.5" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
        <rect x="10" y="17.6" width="12" height="2.8" rx="1.4" fill="hsl(var(--brand))" />
      </svg>
      authkestra
    </a>

    <ul class="links">
      <li><a href="https://docs.authkestra.com">Docs</a></li>
      <li><a href="https://play.authkestra.com">Playground</a></li>
      <li>
        <a href="https://github.com/marcjazz/authkestra" class="gh">
          <Icon name="github" size={18} aria-hidden="true" />
          <span>GitHub</span>
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: hsl(var(--background) / 0.72);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid hsl(var(--border));
  }

  .bar {
    max-width: var(--ak-layout-max);
    margin: 0 auto;
    padding: var(--ak-space-4) var(--ak-space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ak-space-4);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--ak-space-2);
    font-size: var(--ak-text-lg);
    font-weight: 600;
    color: hsl(var(--foreground));
    letter-spacing: var(--ak-tracking-tight);
  }

  /*
    The mark carries its own rust in the crossbar, so `color` here sets its
    ink — the two strokes — not the accent. Painting the whole glyph rust
    would make the crossbar vanish into it and lose the one part that means
    anything. This is still the only orange in the nav region.
  */
  .mark {
    color: hsl(var(--foreground));
    flex-shrink: 0;
  }

  .links {
    display: flex;
    align-items: center;
    gap: var(--ak-space-8);
    font-size: var(--ak-text-sm);
    font-weight: 500;
  }

  .links a {
    color: hsl(var(--muted-foreground));
    transition: color var(--ak-duration-fast) var(--ak-ease-out);
  }

  .links a:hover {
    color: hsl(var(--foreground));
  }

  .gh {
    display: inline-flex;
    align-items: center;
    gap: var(--ak-space-2);
  }

  @media (max-width: 640px) {
    .bar {
      padding: var(--ak-space-3) var(--ak-space-4);
    }
    .links {
      gap: var(--ak-space-4);
    }
    .gh span {
      display: none;
    }
    .wordmark {
      font-size: var(--ak-text-base);
    }
  }
</style>
