---
// Renders one inlined Lucide glyph (stroke 1.5, per design/DESIGN.md §6).
// `name="github"` renders the filled brand mark instead of a Lucide path.
import { ICONS, GITHUB_MARK } from '../icons/paths';

interface Props {
  name: string;
  size?: number;
  class?: string;
  "aria-hidden"?: boolean | "true" | "false";
  "aria-label"?: string;
}

const { name, size = 20, class: className, ...rest } = Astro.props;
const isBrand = name === 'github';
const body = isBrand ? '' : ICONS[name];

if (!isBrand && !body) {
  throw new Error(`Icon: unknown icon name "${name}"`);
}
---
{isBrand ? (
  <svg
    class={className}
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="currentColor"
    {...rest}
  >
    <path d={GITHUB_MARK} />
  </svg>
) : (
  <svg
    class={className}
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={1.5}
    stroke-linecap="round"
    stroke-linejoin="round"
    {...rest}
    set:html={body}
  />
)}
