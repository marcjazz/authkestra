---
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="inner">
    <div class="brand">
      <a class="wordmark" href="#top">
        <svg class="mark" width="20" height="20" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <path d="M5.5 27.5 16 5l10.5 22.5" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
          <rect x="10" y="17.6" width="12" height="2.8" rx="1.4" fill="hsl(var(--brand))" />
        </svg>
        authkestra
      </a>
      <p>A modular, framework-agnostic authentication orchestration engine for Rust.</p>
    </div>

    <nav class="cols" aria-label="Footer">
      <div class="col">
        <h3>Project</h3>
        <ul>
          <li><a href="https://docs.authkestra.com">Documentation</a></li>
          <li><a href="https://play.authkestra.com">Playground</a></li>
          <li><a href="https://docs.authkestra.com/guides/quickstart/">Quickstart</a></li>
          <li><a href="https://crates.io/crates/authkestra">crates.io</a></li>
        </ul>
      </div>
      <div class="col">
        <h3>Repository</h3>
        <ul>
          <li>
            <a href="https://github.com/marcjazz/authkestra" class="gh">
              <Icon name="github" size={16} aria-hidden="true" />
              <span>GitHub</span>
            </a>
          </li>
          <li><a href="https://github.com/marcjazz/authkestra/blob/main/LICENSE-MIT">MIT licence</a></li>
          <li><a href="https://github.com/marcjazz/authkestra/blob/main/LICENSE-APACHE">Apache 2.0 licence</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="legal">
    <p>© {year} Authkestra contributors. Dual-licensed under MIT or Apache-2.0, at your option.</p>
  </div>
</footer>

<style>
  .footer {
    max-width: var(--ak-layout-max);
    margin: 0 auto;
    padding: var(--ak-space-16) var(--ak-space-6) var(--ak-space-8);
    border-top: 1px solid hsl(var(--border));
  }

  .inner {
    display: flex;
    justify-content: space-between;
    gap: var(--ak-space-16);
    flex-wrap: wrap;
  }

  .brand {
    max-width: 34ch;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--ak-space-2);
    font-size: var(--ak-text-lg);
    font-weight: 600;
    color: hsl(var(--foreground));
  }

  /* Ink, not accent — the crossbar is the rust. See Nav.astro. */
  .mark {
    color: hsl(var(--foreground));
  }

  .brand p {
    margin-top: var(--ak-space-3);
    font-size: var(--ak-text-sm);
    color: hsl(var(--muted-foreground));
  }

  .cols {
    display: flex;
    gap: var(--ak-space-16);
  }

  .col h3 {
    font-size: var(--ak-text-xs);
    color: hsl(var(--foreground));
    font-weight: 600;
  }

  .col ul {
    margin-top: var(--ak-space-3);
    display: flex;
    flex-direction: column;
    gap: var(--ak-space-2);
  }

  .col a {
    font-size: var(--ak-text-sm);
    color: hsl(var(--muted-foreground));
    transition: color var(--ak-duration-fast) var(--ak-ease-out);
  }

  .col a:hover {
    color: hsl(var(--foreground));
  }

  .gh {
    display: inline-flex;
    align-items: center;
    gap: var(--ak-space-2);
  }

  .legal {
    margin-top: var(--ak-space-12);
    padding-top: var(--ak-space-6);
    border-top: 1px solid hsl(var(--border));
    font-size: var(--ak-text-xs);
    color: hsl(var(--muted-foreground) / 0.75);
  }

  @media (max-width: 640px) {
    .footer {
      padding: var(--ak-space-12) var(--ak-space-4) var(--ak-space-6);
    }
    .inner {
      gap: var(--ak-space-8);
    }
    .cols {
      gap: var(--ak-space-8);
      width: 100%;
    }
  }
</style>
