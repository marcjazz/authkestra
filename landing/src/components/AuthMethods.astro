---
import Icon from './Icon.astro';

const methods = [
  {
    icon: 'fingerprint',
    title: 'Passkeys (WebAuthn)',
    body: 'Phishing-resistant sign-in backed by the platform authenticator — no password to steal.',
    href: 'https://docs.authkestra.com/providers/passkeys/',
  },
  {
    icon: 'smartphone',
    title: 'TOTP (authenticator apps)',
    body: 'Time-based one-time codes for a second factor, enrolled and verified against your own store.',
    href: 'https://docs.authkestra.com/providers/totp/',
  },
  {
    icon: 'key-round',
    title: 'Stateless OAuth2',
    body: 'Social sign-in with the OAuth dance handled for you, state and nonce kept out of your database.',
    href: 'https://docs.authkestra.com/providers/oauth2/',
  },
  {
    icon: 'id-card',
    title: 'OIDC provider (client)',
    body: 'Verify identity against any OpenID Connect provider using discovery and cached signing keys.',
    href: 'https://docs.authkestra.com/providers/oidc/',
  },
  {
    icon: 'server',
    title: 'Client credentials',
    body: 'Machine-to-machine authentication for services that authenticate as themselves, not a user.',
    href: 'https://docs.authkestra.com/providers/client-credentials/',
  },
  {
    icon: 'tv-minimal',
    title: 'Device flow',
    body: 'Sign in on a second screen — built for TVs, CLIs, and anything without a convenient browser.',
    href: 'https://docs.authkestra.com/providers/device-flow/',
  },
  {
    icon: 'shield-check',
    title: 'Bot protection (CAPTCHA)',
    body: 'Challenge suspect traffic before it reaches your authentication logic, not after.',
    href: 'https://docs.authkestra.com/providers/bot-protection/',
  },
  {
    icon: 'badge-check',
    title: 'Device signatures',
    body: 'Proof-of-possession backed by an issuer attestation, for clients that must prove which device they are.',
    href: 'https://docs.authkestra.com/providers/device-signatures/',
  },
];
---
<section id="methods" class="methods" aria-labelledby="methods-heading">
  <h2 id="methods-heading">Eight ways to prove who someone is</h2>
  <p class="lead">
    Each one is a strategy you hand to the same engine. Mix them, chain them, or
    ship just one — the shape of your code doesn't change.
  </p>

  <ul class="grid">
    {methods.map((m) => (
      <li>
        <a class="card" href={m.href}>
          <Icon name={m.icon} size={24} class="icon" aria-hidden="true" />
          <h3>{m.title}</h3>
          <p>{m.body}</p>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .methods {
    max-width: var(--ak-layout-max);
    margin: 0 auto;
    padding: var(--ak-space-24) var(--ak-space-6);
  }

  h2 {
    font-size: var(--ak-text-3xl);
  }

  .lead {
    margin-top: var(--ak-space-4);
    max-width: 56ch;
    color: hsl(var(--muted-foreground));
  }

  .grid {
    margin-top: var(--ak-space-10);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--ak-space-4);
  }

  .card {
    display: block;
    height: 100%;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    padding: var(--ak-space-5);
    transition: border-color var(--ak-duration-fast) var(--ak-ease-out);
  }

  .card:hover {
    border-color: hsl(var(--input));
  }

  /*
    Rust as a set, not as eight competing accents — see DESIGN.md §2, rule 1.
    Every card in this grid is styled identically, so the colour reads once,
    as "these are the methods", which is exactly what this section is for.
  */
  .icon {
    color: hsl(var(--primary-accent));
  }

  h3 {
    margin-top: var(--ak-space-3);
    font-size: var(--ak-text-sm);
    font-weight: 600;
    color: hsl(var(--foreground));
  }

  .card p {
    margin-top: var(--ak-space-1);
    font-size: var(--ak-text-xs);
    color: hsl(var(--muted-foreground));
    line-height: var(--ak-leading-normal);
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .methods {
      padding: var(--ak-space-16) var(--ak-space-4);
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
