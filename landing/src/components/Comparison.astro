---
import Icon from './Icon.astro';

// A "yes" cell: paired icon + word, never colour alone (DESIGN.md §2, §8).
const yes = (label: string) => ({ kind: 'yes' as const, label });
const plain = (label: string) => ({ kind: 'plain' as const, label });
const muted = (label: string) => ({ kind: 'muted' as const, label });

const rows = [
  {
    feature: 'Category',
    authkestra: plain('Embedded identity engine'),
    embeddedAlt: plain('Embedded auth library'),
    standalone: plain('Standalone IdP server'),
  },
  {
    feature: 'OAuth2 / OIDC role',
    authkestra: yes('Provider, client, and resource server — one crate'),
    embeddedAlt: muted('Relying party only'),
    standalone: yes('Full provider support'),
  },
  {
    feature: 'Resource server',
    authkestra: yes('Native — DPoP (RFC 9449) & mTLS (RFC 8705) binding'),
    embeddedAlt: muted('Not offered'),
    standalone: yes('API validation'),
  },
  {
    feature: 'Configuration safety',
    authkestra: yes('Strict — typestate builder'),
    embeddedAlt: muted('Not documented'),
    standalone: muted('N/A — external config'),
  },
  {
    feature: 'State management',
    authkestra: plain('Stateless, encrypted cookies'),
    embeddedAlt: plain('Stateful — Redis or in-memory'),
    standalone: plain('Stateful, dedicated DB'),
  },
  {
    feature: 'Data architecture',
    authkestra: plain('Agnostic, trait-based — any DB'),
    embeddedAlt: plain('SQLite / PostgreSQL built in'),
    standalone: plain('100% yours'),
  },
  {
    feature: 'Passwordless methods',
    authkestra: yes('5 — passkeys, TOTP, magic link, email/SMS OTP, recovery codes'),
    embeddedAlt: yes('Passkeys (WebAuthn)'),
    standalone: yes('Passkeys, plus MFA'),
  },
  {
    feature: 'Fresh proof to enrol a factor',
    authkestra: yes('Required — closes the session-hijack-then-enrol gap'),
    embeddedAlt: muted('Not documented'),
    standalone: muted('Not documented'),
  },
  {
    feature: 'Device signatures',
    authkestra: yes('Built in — proof-of-possession + attestation'),
    embeddedAlt: muted('Not offered'),
    standalone: muted('Not offered'),
  },
  {
    feature: 'Bot / abuse protection',
    authkestra: yes('CAPTCHA — Turnstile, hCaptcha, reCAPTCHA'),
    embeddedAlt: muted('Not offered'),
    standalone: plain('Rate-limit & IP-block (Rauthy)'),
  },
];
---
<section id="comparison" class="comparison" aria-labelledby="comparison-heading">
  <h2 id="comparison-heading">Authkestra vs. the world</h2>
  <p class="lead">
    In the Rust ecosystem you generally choose between a standalone identity
    provider and a library you embed. Authkestra sits in between: a modular
    identity engine, embedded in your binary, that plays all three OAuth2/OIDC
    roles — provider, client, and resource server — in one crate. Here is how
    it compares to a well-scoped embedded library and to the standalone
    servers, both of which are good at what they set out to do.
  </p>

  <div class="table-scroll">
    <table>
      <caption class="visually-hidden">
        Feature comparison between Authkestra, oauth2-passkey, and standalone servers Rauthy and Kanidm
      </caption>
      <thead>
        <tr>
          <th scope="col">Feature</th>
          <th scope="col" class="col-ak">Authkestra</th>
          <th scope="col">oauth2-passkey</th>
          <th scope="col">Rauthy / Kanidm</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row">{r.feature}</th>
            {[r.authkestra, r.embeddedAlt, r.standalone].map((cell, i) => (
              <td class:list={[{ 'col-ak': i === 0 }]}>
                {cell.kind === 'yes' && (
                  <span class="verdict yes">
                    <Icon name="circle-check" size={16} aria-hidden="true" />
                    {cell.label}
                  </span>
                )}
                {cell.kind === 'muted' && <span class="verdict muted">{cell.label}</span>}
                {cell.kind === 'plain' && <span class="verdict plain">{cell.label}</span>}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="detail">
    <div>
      <h3>vs. oauth2-passkey</h3>
      <p>
        A clean, framework-agnostic core for signing users in with Google-style
        OAuth2 and passkeys, backed by its own Redis/SQL session store. It's a
        relying party, not a provider — there's no OP to issue tokens for your
        own other services, and no resource-server side to validate them.
        Authkestra plays all three roles from one crate, with the same
        passkey ceremony plus four more passwordless methods alongside it.
      </p>
    </div>
    <div>
      <h3>vs. Rauthy &amp; Kanidm</h3>
      <p>
        Both are excellent, fast standalone identity servers — the right call
        when you want a dedicated IdP microservice, and both take security at
        least as seriously as Authkestra does. Authkestra gives you the same OP
        capability without the extra service to deploy, the network hop, or the
        database to back up — plus a resource-server SDK and an OIDC client for
        your own app's other logins, which a standalone IdP doesn't hand you.
      </p>
    </div>
  </div>
</section>

<style>
  .comparison {
    max-width: var(--ak-layout-max);
    margin: 0 auto;
    padding: var(--ak-space-24) var(--ak-space-6);
  }

  h2 {
    font-size: var(--ak-text-3xl);
  }

  .lead {
    margin-top: var(--ak-space-4);
    max-width: var(--ak-layout-prose);
    color: hsl(var(--muted-foreground));
  }

  .table-scroll {
    margin-top: var(--ak-space-10);
    overflow-x: auto;
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    background: hsl(var(--card));
  }

  table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: var(--ak-text-sm);
  }

  th, td {
    text-align: left;
    padding: var(--ak-space-3) var(--ak-space-4);
    border-bottom: 1px solid hsl(var(--border));
    white-space: nowrap;
  }

  thead th {
    color: hsl(var(--foreground));
    font-weight: 600;
    background: hsl(var(--popover));
  }

  tbody th {
    color: hsl(var(--foreground));
    font-weight: 500;
    white-space: normal;
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: none;
  }

  .verdict {
    display: inline-flex;
    align-items: center;
    gap: var(--ak-space-2);
    white-space: normal;
  }

  .verdict.yes {
    color: hsl(var(--success-foreground));
  }

  .verdict.yes :global(svg) {
    flex-shrink: 0;
  }

  .verdict.muted {
    color: hsl(var(--muted-foreground) / 0.75);
  }

  /*
    The Authkestra column is the subject of the table, so it is tinted and its
    plain text takes the accent — a reader scanning ten rows should not have to
    re-find which column is ours each time.

    The verdict cells inside it deliberately stay green. Rust here answers
    "which column is this about", green answers "is it supported", and those
    are different questions; colouring both with the accent would collapse them
    into one and make a supported feature indistinguishable from an unsupported
    one in our own column. `--primary-subtle` is the one warm surface the system
    allows (DESIGN.md §3), and at this alpha the accent text clears AA on it at
    6.8:1 with the green at 8.9:1.
  */
  .col-ak {
    background: hsl(var(--primary-subtle) / 0.55);
  }

  thead .col-ak {
    color: hsl(var(--primary-accent));
  }

  .col-ak .verdict.plain {
    color: hsl(var(--primary-accent));
  }

  .verdict.plain {
    color: hsl(var(--muted-foreground));
  }

  .detail {
    margin-top: var(--ak-space-10);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--ak-space-8);
  }

  .detail h3 {
    font-size: var(--ak-text-lg);
  }

  .detail p {
    margin-top: var(--ak-space-2);
    font-size: var(--ak-text-sm);
    color: hsl(var(--muted-foreground));
  }

  @media (max-width: 720px) {
    .detail {
      grid-template-columns: 1fr;
      gap: var(--ak-space-6);
    }
  }

  @media (max-width: 560px) {
    .comparison {
      padding: var(--ak-space-16) var(--ak-space-4);
    }
  }
</style>
